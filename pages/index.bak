    </div>
  );

  // Optimized error state
  const renderError = () => (
    <div className="flex flex-col items-center justify-center min-h-[60vh] p-8 text-center">
      <div className="mb-6">
        <div className="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-50 mb-4">
