            <rect x="5.5" y="9.5" width="2" height="5" rx="0.3" fill="#F59E0B" />
            <rect x="16" y="9" width="3" height="6" rx="0.5" fill="#B45309" />
            <rect x="16.5" y="9.5" width="2" height="5" rx="0.3" fill="#F59E0B" />
