import React, {
    useState,
    useEffect,
    useContext,
    useMemo,
    useCallback,
    useRef,
  } from "react";
  import PropTypes from "prop-types";
  import { useRouter } from "next/router";
  import Head from "next/head";
  import Script from "next/script";
  import Styles from "../../styles/CategoriesWorkersIndex.module.css";
  import Grid from "@mui/material/Grid";
  import Box from "@mui/material/Box";
  import WorkerCard from "../../components/cards/WorkerCard";
  import Link from "next/link";
  import WorkerFilter from "../../components/WorkerFilter";
  import { CityContext } from "../../components/parts/CityContext";
  import { useMediaQuery, useTheme } from "@mui/material";
  import Breadcrumbs from "@mui/material/Breadcrumbs";
  import HomeIcon from "@mui/icons-material/Home";
  import LocationOnIcon from "@mui/icons-material/LocationOn";
  import CategoryIcon from "@mui/icons-material/Category";
  import Button from "@mui/material/Button";
  import CircularProgress from "@mui/material/CircularProgress";
  import Alert from "@mui/material/Alert";
  import Skeleton from "@mui/material/Skeleton";
  import axios from "axios";
  import dynamic from "next/dynamic";
  import { getPersianCityName } from "../../components/util/cityNames";
  
  const FileRequest = dynamic(() => import("../../components/request/FileRequest"), {
    ssr: false,
    loading: () => <div className="section-skeleton" />,
  });
  
  const MemoizedWorkerCard = React.memo(WorkerCard, (prevProps, nextProps) => {
    return prevProps.worker.id === nextProps.worker.id;
  });
  
  const CardSkeleton = () => (
    <Grid item xs={12} sm={6} md={4}>
      <Skeleton variant="rectangular" height={200} sx={{ borderRadius: 2, mb: 1 }} />
      <Skeleton variant="text" sx={{ fontSize: "1rem" }} />
      <Skeleton variant="text" sx={{ fontSize: "1rem", width: "60%" }} />
    </Grid>
  );
  
  function normalizePriceToIRR(price) {
    if (!price) return null;
    const n = String(price).replace(/[^0-9]/g, "");
    return n ? n : null;
  }
  
  function getSingleParam(value) {
    if (Array.isArray(value)) return value[0] || "";
    return value || "";
  }
  
  function getSlugArray(slug) {
    if (Array.isArray(slug)) return slug;
    if (slug) return [slug];
    return [];
  }
  
  function isMultiNeighborhoodValue(value) {
    return String(value || "").includes(",");
  }
  
  function cleanRouterQuery(query = {}) {
    const cleaned = { ...query };
  
    /**
     * These are dynamic route params from Next.js.
     * They must NOT be added as normal query params during router.push/replace.
     */
    delete cleaned.categories;
    delete cleaned.slug;
  
    return cleaned;
  }
  
  /**
   * Finds neighborhood by:
   * - numeric id, for old filter URLs: ?neighborhoods=1
   * - English slug, for SEO URLs: /city/category/sheikh-zahed
   * - fallback fields, if your API uses slug/value/name/title
   */
  function findNeighborhoodBySlugOrId(neighborhoods, value) {
    if (!value || !Array.isArray(neighborhoods)) return null;
  
    const stringValue = String(value);
  
    /**
     * If value is multiple ids like "1,2", it is not one neighborhood.
     */
    if (stringValue.includes(",")) return null;
  
    return (
      neighborhoods.find((item) => {
        return (
          String(item?.id) === stringValue ||
          String(item?.eng_name || "") === stringValue ||
          String(item?.slug || "") === stringValue ||
          String(item?.value || "") === stringValue ||
          String(item?.name || "") === stringValue ||
          String(item?.title || "") === stringValue
        );
      }) || null
    );
  }
  
  function getNeighborhoodDisplayName(neighborhoods, value) {
    const found = findNeighborhoodBySlugOrId(neighborhoods, value);
    return found?.name || found?.title || "";
  }
  
  function buildWorkersApiUrl({
    catname,
    city,
    page = 1,
    per_page = 10,
    query = {},
    finalNeighborhoodId = "",
  }) {
    let apiUrl = `https://api.ajur.app/api/server-filtered-workers?catname=${encodeURIComponent(
      catname
    )}&city=${encodeURIComponent(city)}&page=${page}&per_page=${per_page}`;
  
    if (query.categoryId) {
      apiUrl += `&category_id=${encodeURIComponent(getSingleParam(query.categoryId))}`;
    }
  
    if (query.features) {
      apiUrl += `&features=${encodeURIComponent(getSingleParam(query.features))}`;
    }
  
    /**
     * IMPORTANT:
     * Old working backend format:
     *    neighborhoods=<id>
     *
     * Supports both:
     *    neighborhoods=3
     *    neighborhoods=3,1
     *
     * Do NOT use:
     *    neighborhood_id=<id>
     */
    if (finalNeighborhoodId) {
      apiUrl += `&neighborhoods=${encodeURIComponent(finalNeighborhoodId)}`;
    }
  
    Object.keys(query).forEach((key) => {
      if (key.includes("_min") || key.includes("_max")) {
        apiUrl += `&${key}=${encodeURIComponent(getSingleParam(query[key]))}`;
      }
    });
  
    if (query.sortBy && query.sortBy !== "newest") {
      const sortMap = {
        newest: "created_at_desc",
        oldest: "created_at_asc",
        most_viewed: "total_view_desc",
      };
  
      const [field, order] = sortMap[query.sortBy]?.split("_") || [
        "created_at",
        "desc",
      ];
  
      apiUrl += `&sort_by=${field}&sort_order=${order}`;
    }
  
    return apiUrl;
  }
  
  const SingleCategory = ({
    initialWorkers = [],
    initialSpecialWorkers = [],
    initialPagination = {
      current_page: 1,
      per_page: 10,
      total_count: 0,
      total_pages: 1,
    },
    initialDetails = {},
    initialMainCats = [],
    initialNeighborhoods = [],
    initialError = false,
    initialErrorMessage = "",
    cityFromServer,
    nameFromServer,
    neighborhoodFromServer,
  }) => {
    const router = useRouter();
  
    /**
     * Important:
     * After client-side route changes, do NOT keep using neighborhoodFromServer.
     * Otherwise /city/category/mosala -> /city/category still keeps old "mosala"
     * from SSR props.
     */
    const routerSlugArray = getSlugArray(router.query?.slug);
  
    const city = router.isReady
      ? getSingleParam(router.query?.categories) || cityFromServer || "tehran"
      : cityFromServer || "tehran";
  
    const slugName = router.isReady
      ? routerSlugArray[0] || nameFromServer || ""
      : nameFromServer || "";
  
    const routeNeighborhoodSlug = router.isReady
      ? routerSlugArray[1] || ""
      : neighborhoodFromServer || "";
  
    const { currentCity } = useContext(CityContext);
    const theme = useTheme();
    const isMobile = useMediaQuery(theme.breakpoints.down("md"));
  
    const firstClientFetchSkippedRef = useRef(false);
  
    const [workersState, set_workers] = useState(initialWorkers);
    const [SpecialworkersState, set_special_workers] = useState(initialSpecialWorkers);
    const [pagination, setPagination] = useState(initialPagination);
  
    const [filterLoading, setFilterLoading] = useState(false);
    const [loadingMore, setLoadingMore] = useState(false);
  
    const [error, setError] = useState(initialError);
    const [errorMessage, setErrorMessage] = useState(initialErrorMessage);
  
    const [details, setDetails] = useState(initialDetails);
    const [main_cats, setMainCats] = useState(initialMainCats);
    const [neighborhoods, setNeighborhoods] = useState(initialNeighborhoods);
  
    const [activeFilterCount, setActiveFilterCount] = useState(0);
    const [y_scroll, set_y_scroll] = useState(0);
  
    const persian_city = useMemo(() => getPersianCityName(city), [city]);
  
    const persian_category_name =
      details?.name ||
      main_cats.find((c) => c.eng_name === slugName)?.name ||
      "";
  
    /**
     * Neighborhood source can be:
     *
     * 1. SEO URL:
     *    /lahijan/buy-apartment/sheikh-zahed
     *
     * 2. Old or multiple filter URL:
     *    /robat-karim/buy-apartment?page=1&neighborhoods=1
     *    /robat-karim/buy-apartment?page=1&neighborhoods=3,1
     *
     * For API we always send:
     *    neighborhoods=<numeric id or comma-separated ids>
     */
    const queryNeighborhood = getSingleParam(router.query?.neighborhoods);
    const hasQueryNeighborhood = Boolean(queryNeighborhood);
    const hasMultipleNeighborhoods = isMultiNeighborhoodValue(queryNeighborhood);
  
    /**
     * If query neighborhood exists, query wins.
     * This is important when user selects filters while currently on SEO URL.
     */
    const activeNeighborhoodValue = hasQueryNeighborhood
      ? queryNeighborhood
      : routeNeighborhoodSlug;
  
    const neighborhoodObject = useMemo(() => {
      return findNeighborhoodBySlugOrId(neighborhoods, activeNeighborhoodValue);
    }, [neighborhoods, activeNeighborhoodValue]);
  
    const neighborhoodId = useMemo(() => {
      /**
       * Multiple query:
       * neighborhoods=3,1
       * Keep exact value for backend.
       */
      if (hasQueryNeighborhood) return queryNeighborhood;
  
      /**
       * SEO slug:
       * /city/category/mosala
       * Resolve to id.
       */
      if (neighborhoodObject?.id) return neighborhoodObject.id;
  
      return "";
    }, [hasQueryNeighborhood, queryNeighborhood, neighborhoodObject]);
  
    /**
     * For SEO display, only show Persian neighborhood name when there is exactly
     * one neighborhood represented by path slug or single id.
     *
     * For multiple selected neighborhoods, avoid title like:
     * "buy apartment in mosala"
     * because the actual filter is multiple neighborhoods.
     */
    const neighborhoodName = useMemo(() => {
      if (hasMultipleNeighborhoods) return "";
  
      if (neighborhoodObject?.name) return neighborhoodObject.name;
      if (neighborhoodObject?.title) return neighborhoodObject.title;
  
      return getNeighborhoodDisplayName(neighborhoods, activeNeighborhoodValue);
    }, [
      hasMultipleNeighborhoods,
      neighborhoodObject,
      neighborhoods,
      activeNeighborhoodValue,
    ]);
  
    const totalCount = useMemo(
      () => pagination.total_count || workersState.length,
      [pagination, workersState]
    );
  
    const hasMore = useMemo(() => {
      return pagination.current_page < pagination.total_pages;
    }, [pagination]);
  
    /**
     * Canonical:
     * - Single SEO neighborhood pages use clean slug URL.
     * - Multiple neighborhood filter pages canonicalize to category page.
     */
    const canonicalUrl =
      routeNeighborhoodSlug && !hasMultipleNeighborhoods && !hasQueryNeighborhood
        ? `https://ajur.app/${city}/${slugName}/${routeNeighborhoodSlug}`
        : `https://ajur.app/${city}/${slugName}`;
  
    /**
     * Make WorkerFilter know about the active neighborhood.
     *
     * If URL is:
     * /city/category/mosala
     *
     * WorkerFilter receives:
     * neighborhoods=<resolved id>
     *
     * If URL is:
     * /city/category?page=1&neighborhoods=1,2
     *
     * WorkerFilter receives:
     * neighborhoods=1,2
     */
    const appliedFiltersForWorkerFilter = useMemo(() => {
      if (neighborhoodId) {
        return {
          ...(router.query || {}),
          neighborhoods: String(neighborhoodId),
        };
      }
  
      return router.query || {};
    }, [router.query, neighborhoodId]);
  
    /**
     * Fix #2:
     * If user is on an SEO neighborhood URL and then selects multiple neighborhoods,
     * remove the SEO neighborhood slug from the path.
     *
     * Bad:
     * /robat-karim/buy-apartment/mosala?page=1&neighborhoods=1,2
     *
     * Good:
     * /robat-karim/buy-apartment?page=1&neighborhoods=1,2
     */
    useEffect(() => {
      if (!router.isReady) return;
      if (!routeNeighborhoodSlug) return;
      if (!hasMultipleNeighborhoods) return;
  
      const cleanedQuery = cleanRouterQuery(router.query);
  
      router.replace(
        {
          pathname: `/${city}/${slugName}`,
          query: {
            ...cleanedQuery,
            page: cleanedQuery.page || 1,
            neighborhoods: queryNeighborhood,
          },
        },
        undefined,
        { shallow: true }
      );
    }, [
      router.isReady,
      router.query,
      routeNeighborhoodSlug,
      hasMultipleNeighborhoods,
      city,
      slugName,
      queryNeighborhood,
    ]);
  
    /**
     * Fix #1:
     * Client-side refetch when filters in URL change.
     *
     * Without this, Next.js changes the URL but getServerSideProps does not run,
     * so user must refresh manually.
     */
    useEffect(() => {
      if (!router.isReady) return;
      if (!slugName || !city) return;
  
      /**
       * Skip first client run because SSR already loaded initial data.
       */
      if (!firstClientFetchSkippedRef.current) {
        firstClientFetchSkippedRef.current = true;
        return;
      }
  
      /**
       * If current URL is going to be normalized by the previous effect,
       * do not fetch from the invalid URL.
       */
      if (routeNeighborhoodSlug && hasMultipleNeighborhoods) {
        return;
      }
  
      const fetchFilteredWorkers = async () => {
        try {
          setFilterLoading(true);
          setError(false);
          setErrorMessage("");
  
          const query = router.query || {};
          const page = query.page ? parseInt(getSingleParam(query.page), 10) : 1;
          const per_page = pagination.per_page || 10;
  
          /**
           * Priority:
           * 1. query neighborhoods if exists, supports "1,2"
           * 2. resolved SEO slug id
           */
          const finalNeighborhoodId = queryNeighborhood || neighborhoodId || "";
  
          const apiUrl = buildWorkersApiUrl({
            catname: slugName,
            city,
            page,
            per_page,
            query,
            finalNeighborhoodId,
          });
  
          const response = await axios.get(apiUrl, {
            timeout: 8000,
            headers: { Accept: "application/json" },
          });
  
          const data = response.data;
  
          set_workers(data.workers || []);
          set_special_workers(data.special_workers || []);
  
          setPagination(
            data.pagination || {
              current_page: page,
              per_page,
              total_count: data.workers?.length || 0,
              total_pages: 1,
            }
          );
  
          if (data?.filters_applied?.persian_category_name) {
            setDetails({
              name: data.filters_applied.persian_category_name,
              id: data.filters_applied.category_id,
            });
          }
        } catch (e) {
          console.error("Client filter fetch error:", e);
          setError(true);
          setErrorMessage("خطا در دریافت اطلاعات. لطفا بعدا تلاش کنید.");
        } finally {
          setFilterLoading(false);
        }
      };
  
      fetchFilteredWorkers();
    }, [
      router.isReady,
      router.asPath,
      slugName,
      city,
      routeNeighborhoodSlug,
      hasMultipleNeighborhoods,
      queryNeighborhood,
      neighborhoodId,
      pagination.per_page,
    ]);
  
    useEffect(() => {
      const handleScroll = () => {
        set_y_scroll(window.scrollY);
      };
  
      window.addEventListener("scroll", handleScroll, { passive: true });
  
      return () => window.removeEventListener("scroll", handleScroll);
    }, []);
  
    const handleCategoryChange = (newCategory) => {
      if (newCategory) {
        router.push({
          pathname: `/${city}/${newCategory.eng_name}`,
        });
      } else {
        router.push(`/${city}`);
      }
    };
  
    const loadMoreWorkers = useCallback(async () => {
      if (loadingMore || !hasMore) return;
  
      setLoadingMore(true);
  
      const nextPage = pagination.current_page + 1;
  
      try {
        const query = router.query || {};
  
        /**
         * Priority:
         * 1. query neighborhoods if exists, supports "1,2"
         * 2. resolved SEO slug id
         */
        const finalNeighborhoodId = queryNeighborhood || neighborhoodId || "";
  
        const apiUrl = buildWorkersApiUrl({
          catname: slugName,
          city,
          page: nextPage,
          per_page: pagination.per_page,
          query,
          finalNeighborhoodId,
        });
  
        const response = await axios.get(apiUrl, {
          timeout: 8000,
          headers: { Accept: "application/json" },
        });
  
        const data = response.data;
  
        set_workers((prev) => {
          const existingIds = new Set(prev.map((w) => w.id));
          const newWorkers = (data.workers || []).filter((w) => !existingIds.has(w.id));
          return [...prev, ...newWorkers];
        });
  
        setPagination(
          data.pagination || {
            current_page: nextPage,
            per_page: pagination.per_page,
            total_count: pagination.total_count,
            total_pages: pagination.total_pages,
          }
        );
      } catch (e) {
        console.error("Error loading more workers:", e);
      } finally {
        setLoadingMore(false);
      }
    }, [
      loadingMore,
      hasMore,
      pagination,
      router.query,
      slugName,
      city,
      queryNeighborhood,
      neighborhoodId,
    ]);
  
    const seoTitle = useMemo(() => {
      if (neighborhoodName) {
        if (totalCount > 0) {
          return `${persian_category_name} در ${neighborhoodName} ${persian_city} | لیست ${totalCount} آگهی | آجر`;
        }
  
        return `${persian_category_name} در ${neighborhoodName} ${persian_city} | آجر`;
      }
  
      if (totalCount > 0) {
        return `${persian_category_name} در ${persian_city} | لیست ${totalCount} آگهی | آجر`;
      }
  
      return `${persian_category_name} در ${persian_city} | آجر`;
    }, [persian_category_name, persian_city, neighborhoodName, totalCount]);
  
    const seoDescription = useMemo(() => {
      if (neighborhoodName) {
        if (totalCount > 0) {
          return `${totalCount} آگهی ${persian_category_name} در ${neighborhoodName} ${persian_city}. جدیدترین فایل‌ها، قیمت‌ها و مشخصات را در آجر ببینید.`;
        }
  
        return `جدیدترین آگهی‌های ${persian_category_name} در ${neighborhoodName} ${persian_city} در آجر.`;
      }
  
      if (totalCount > 0) {
        return `${totalCount} آگهی ${persian_category_name} در ${persian_city}. جدیدترین فایل‌ها، قیمت‌ها و مشخصات را در آجر ببینید.`;
      }
  
      return `جدیدترین آگهی‌های ${persian_category_name} در ${persian_city} در آجر.`;
    }, [persian_category_name, persian_city, neighborhoodName, totalCount]);
  
    const seoImage = details?.avatar
      ? `https://api.ajur.app/cats_image/${details.avatar}.jpg`
      : "https://api.ajur.app/logo/og-default.jpg";
  
