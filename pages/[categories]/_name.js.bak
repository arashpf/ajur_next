              {renderHeader()}
              <Box sx={{ flexGrow: 1, py: 3, px: { xs: 2, sm: 3 } }}> {/* Add padding on sides */}
  <Grid 
    container 
    spacing={{ xs: 2, sm: 3 }} // Consistent spacing
    justifyContent={{ xs: "center", sm: "flex-start" }}
    sx={{
      margin: '0 auto',
      maxWidth: '100%'
    }}
  >
    {renderWorkers()}
  </Grid>
</Box>
            </div>
