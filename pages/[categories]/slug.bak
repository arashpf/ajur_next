};

export default SingleCategory;

SingleCategory.propTypes = {
  initialWorkers: PropTypes.array,
  initialSpecialWorkers: PropTypes.array,
  initialPagination: PropTypes.object,
  initialDetails: PropTypes.object,
  initialMainCats: PropTypes.array,
  initialNeighborhoods: PropTypes.array,
  initialSeoNeighborhoods: PropTypes.array,
  initialError: PropTypes.bool,
  initialErrorMessage: PropTypes.string,
  cityFromServer: PropTypes.string,
  nameFromServer: PropTypes.string,
  neighborhoodFromServer: PropTypes.string,
};

export async function getServerSideProps(context) {
  const { categories, slug = [] } = context.params || {};

  const slugArray = Array.isArray(slug) ? slug : [];

  const city = categories || "tehran";
  const catname = slugArray[0] || "";
  const neighborhoodSlug = slugArray[1] || "";

  const query = context.query || {};
  const page = query.page ? parseInt(getSingleParam(query.page), 10) : 1;
  const per_page = 10;

  if (!catname) {
    return {
      notFound: true,
    };
  }

  let baseData = null;

  try {
    const baseRes = await axios.get(
      `https://api.ajur.app/api/base?city=${encodeURIComponent(city)}`,
      {
        timeout: 8000,
        headers: { Accept: "application/json" },
      }
    );

    baseData = baseRes.data;
  } catch (e) {
    console.error("Base fetch error:", e);
  }

  const queryNeighborhood = getSingleParam(query.neighborhoods);
  const hasQueryNeighborhood = Boolean(queryNeighborhood);
  const hasMultipleNeighborhoods = isMultiNeighborhoodValue(queryNeighborhood);

  if (neighborhoodSlug && hasMultipleNeighborhoods) {
    const cleanedQuery = cleanRouterQuery(query);

    return {
      redirect: {
        destination: `/${city}/${catname}?${new URLSearchParams({
          ...cleanedQuery,
          page: String(cleanedQuery.page || 1),
          neighborhoods: queryNeighborhood,
        }).toString()}`,
        permanent: false,
      },
    };
  }

  let resolvedNeighborhood = null;

  if (!hasQueryNeighborhood && neighborhoodSlug && baseData?.the_neighborhoods) {
    resolvedNeighborhood = findNeighborhoodBySlugOrId(
      baseData.the_neighborhoods,
      neighborhoodSlug
    );
  }

  if (!resolvedNeighborhood && queryNeighborhood && baseData?.the_neighborhoods) {
    resolvedNeighborhood = findNeighborhoodBySlugOrId(
      baseData.the_neighborhoods,
      queryNeighborhood
    );
  }

  const finalNeighborhoodId = hasQueryNeighborhood
    ? queryNeighborhood
    : resolvedNeighborhood?.id || "";

  const apiUrl = buildWorkersApiUrl({
    catname,
    city,
    page,
    per_page,
    query,
    finalNeighborhoodId,
  });

  try {
    const workersRes = await axios.get(apiUrl, {
      timeout: 8000,
      headers: { Accept: "application/json" },
    });

    const workersData = workersRes.data;

    const initialWorkers = workersData?.workers || [];
    const initialSpecialWorkers = workersData?.special_workers || [];
    const initialSeoNeighborhoods = workersData?.the_city_category_neighborhoods || [];

    const initialPagination =
      workersData?.pagination || {
        current_page: page,
        per_page,
        total_count: initialWorkers.length,
        total_pages: Math.ceil((initialWorkers.length || 0) / per_page),
      };

    const initialDetails = workersData?.filters_applied?.persian_category_name
      ? {
          name: workersData.filters_applied.persian_category_name,
          id: workersData.filters_applied.category_id,
        }
      : {};

    return {
      props: {
        initialWorkers,
        initialSpecialWorkers,
        initialPagination,
        initialDetails,
        initialMainCats: baseData?.cats || [],
        initialNeighborhoods: baseData?.the_neighborhoods || [],
        initialSeoNeighborhoods,
        initialError: false,
        initialErrorMessage: "",
        cityFromServer: city,
        nameFromServer: catname,
        neighborhoodFromServer: neighborhoodSlug,
      },
    };
  } catch (e) {
    console.error("SSR fetch error:", e);

    return {
      props: {
        initialWorkers: [],
        initialSpecialWorkers: [],
        initialPagination: {
          current_page: 1,
          per_page: 10,
          total_count: 0,
          total_pages: 1,
        },
        initialDetails: {},
        initialMainCats: baseData?.cats || [],
        initialNeighborhoods: baseData?.the_neighborhoods || [],
        initialSeoNeighborhoods: [],
        initialError: true,
        initialErrorMessage: "خطا در دریافت اطلاعات. لطفا بعدا تلاش کنید.",
        cityFromServer: city,
        nameFromServer: catname,
        neighborhoodFromServer: neighborhoodSlug,
      },
    };
  }
}
























































