                "item": `https://ajur.app/${details.city_slug || 'tehran'}/${details.category_eng_name || 'real-estate'}`
              },
              {
                "@type": "ListItem",
                "position": 4,
                "name": details.name,
                "item": seoData.canonicalUrl
              }
            ]
          })
        }}
      />

      <div 
        className={`${Styles["scroll-div"]} ${Styles["worker-single"]} worker-single-page`} 
        style={{ margin: "0 20px", minHeight: "100vh" }}
      >
        {/* Breadcrumb Navigation */}
        <Breadcrumb
          persianCategory={details.category_name}
          englishCategory={details.category_eng_name}
          englishCity={details.city_slug}
          currentPage={details.name}
        />

        {/* Main Heading for SEO */}
        <div 
          style={{ 
            marginTop: "20px", 
            marginBottom: "30px",
            textAlign: "center"
          }} 
          itemScope 
          itemType="https://schema.org/ProfessionalService"
        >
          <h1 
            style={{ 
              fontSize: "20px", 
              color: "#333",
              margin: 0,
              lineHeight: 1.4
            }}
            itemProp="name"
