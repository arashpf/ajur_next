import React, { useState, useEffect, useMemo, useCallback } from "react";
import PropTypes from "prop-types";
import { useRouter } from "next/router";
import Head from "next/head";
import dynamic from "next/dynamic";
import Cookies from "js-cookie";
import { styled } from "@mui/material/styles";
import Box from "@mui/material/Box";
import Paper from "@mui/material/Paper";
import Grid from "@mui/material/Grid";
import Dialog from "@mui/material/Dialog";
import DialogContent from "@mui/material/DialogContent";
import IconButton from "@mui/material/IconButton";
import CloseIcon from "@mui/icons-material/Close";
import DirectionsIcon from "@mui/icons-material/Directions";
import FavoriteBorderIcon from "@mui/icons-material/FavoriteBorder";
import FavoriteIcon from "@mui/icons-material/Favorite";
import Link from "next/link";

// Helper function - defined outside component
const cleanText = (text) => {
  if (!text || typeof text !== 'string') return '';
  return text
    .replace(/&[a-z]+;/g, '')
    .replace(/[\u200B-\u200D\uFEFF]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
};

// Components - Optimize dynamic imports
const WorkerMedia = dynamic(() => import("../../components/workers/WorkerMedia"), {
  ssr: true,
  loading: () => (
    <div 
      style={{ 
        height: 400, 
        backgroundColor: '#f5f5f5',
        borderRadius: '8px',
        overflow: 'hidden'
      }} 
    />
  ),
});

const WorkerDetails = dynamic(() => import("../../components/workers/WorkerDetails"), { 
  ssr: true,
  loading: () => (
    <div 
      style={{ 
        height: 300, 
        backgroundColor: '#f5f5f5',
        borderRadius: '8px',
        overflow: 'hidden'
      }} 
    />
  ),
});

// Non-critical components as non-SSR
const LocationNoSsr = dynamic(() => import("../../components/map/Location"), {
  ssr: false,
  loading: () => (
    <div 
      style={{ 
        height: 300, 
        backgroundColor: '#f5f5f5',
        borderRadius: '8px'
      }} 
    />
  ),
});

// Import other components - Consider memoizing these
import WorkerCard from "../../components/cards/WorkerCard";
import WorkerRealstateCard from "../../components/cards/realestate/WorkerRealstateCard";
import LazyLoader from "../../components/lazyLoader/Loading";
import Breadcrumb from "../../components/common/Breadcrumb";

// Styles
import Styles from "../../components/styles/WorkerSingle.module.css";

// Create optimized Item component
const Item = React.memo(styled(Paper)(({ theme }) => ({
  backgroundColor: theme.palette.mode === "dark" ? "#1A2027" : "#fff",
  ...theme.typography.body2,
  padding: theme.spacing(1),
  textAlign: "center",
  color: theme.palette.text.secondary,
})));

// Memoize WorkerCard for performance
const MemoizedWorkerCard = React.memo(WorkerCard);

const WorkerSingle = (props) => {
  const [isFavorite, setIsFavorite] = useState(false);
  const [mapModalOpen, setMapModalOpen] = useState(false);
  const [hasHydrated, setHasHydrated] = useState(false);

  const router = useRouter();
  const { slug, id } = router.query;

  // Early hydration
  useEffect(() => {
    setHasHydrated(true);
    
    // Check favorites on client only
    try {
      const favorited = Cookies.get("favorited");
      if (favorited) {
        const favoriteItems = JSON.parse(favorited);
        setIsFavorite(favoriteItems.includes(props.details.id));
      }

      // Update browsing history - debounced
      const updateHistory = () => {
        let history = Cookies.get("history") || "[]";
        let historyItems = JSON.parse(history);
        historyItems = historyItems.filter((item) => item !== props.details.id);
        historyItems.push(props.details.id);

        if (historyItems.length > 10) {
          historyItems = historyItems.slice(-10);
        }

        Cookies.set("history", JSON.stringify(historyItems), { expires: 30 });
      };

      // Delay history update to prioritize rendering
      setTimeout(updateHistory, 2000);
    } catch (error) {
      console.error("Cookie operation failed:", error);
    }
  }, [props.details.id]);

  // OPTIMIZATION: Memoize all cleaned data with minimal computation
  const { details, cleanRealstate, images, videos, virtual_tours, properties, relateds } = useMemo(() => {
    const {
      details: rawDetails,
      properties: rawProperties,
      realstate: rawRealstate,
      relateds: rawRelateds,
      images: rawImages,
      videos: rawVideos,
      virtual_tours: rawVirtualTours,
    } = props;

    // Clean details
    const cleanedDetails = {
      ...rawDetails,
      name: cleanText(rawDetails.name || ''),
      category_name: cleanText(rawDetails.category_name || ''),
      region: cleanText(rawDetails.region || ''),
      city: cleanText(rawDetails.city || ''),
      neighbourhood: cleanText(rawDetails.neighbourhood || ''),
      address: cleanText(rawDetails.address || ''),
      description: cleanText(rawDetails.description || ''),
      // Add SEO-friendly fields
      seo_title: rawDetails.seo_title || '',
      seo_description: rawDetails.seo_description || '',
      seo_keywords: rawDetails.seo_keywords || '',
    };

    // Clean realstate data
    const cleanedRealstate = rawRealstate ? {
      ...rawRealstate,
      name: cleanText(rawRealstate.name || ''),
      slug: rawRealstate.slug || '',
    } : {};

    return {
      details: cleanedDetails,
      cleanRealstate: cleanedRealstate,
      images: rawImages || [],
      videos: rawVideos || [],
      virtual_tours: rawVirtualTours || [],
      properties: rawProperties || [],
      relateds: rawRelateds || [],
    };
  }, [props]);

  // OPTIMIZATION: Memoize toggleFavorite with useCallback
  const toggleFavorite = useCallback(() => {
    try {
      let favorited = Cookies.get("favorited") || "[]";
      let favoriteItems = JSON.parse(favorited);

      if (isFavorite) {
        favoriteItems = favoriteItems.filter((item) => item !== details.id);
      } else {
        if (!favoriteItems.includes(details.id)) {
          favoriteItems.push(details.id);
          if (favoriteItems.length > 20) {
            favoriteItems = favoriteItems.slice(-20);
          }
        }
      }

      Cookies.set("favorited", JSON.stringify(favoriteItems), { expires: 365 });
      setIsFavorite(!isFavorite);
    } catch (error) {
      console.error("Failed to update favorites:", error);
    }
  }, [isFavorite, details.id]);

  // OPTIMIZATION: Memoize SEO header with better metadata
  const seoHeader = useMemo(() => {
    // Generate dynamic metadata
    const pageTitle = details.seo_title || 
      `${details.name} - ${details.category_name} در ${details.region}, ${details.city} | آجر`;
    
    const metaDescription = details.seo_description || 
      (details.description 
        ? details.description.substring(0, 160)
        : `${details.name} - ${details.category_name} در ${details.region}, ${details.city}. مشاور منتخب برای مشاوره و راهنمایی در ${details.category_name}`);
    
    const keywords = details.seo_keywords || 
      `${details.name}, ${details.category_name}, ${details.city}, ${details.region}, ${details.neighbourhood}, مشاور, مشاوره, ${cleanRealstate?.name || ''}`.trim();

    const canonicalUrl = `https://ajur.app/worker/${details.id}`;
    const shareImage = details.thumb || 'https://api.ajur.app/logo/og-default.jpg';
    const siteName = 'آجر - مشاور املاک هوشمند';

    // Structured Data for better SEO
    const structuredData = {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": canonicalUrl,
      name: details.name,
      description: metaDescription,
      image: shareImage,
      url: canonicalUrl,
      telephone: details.phone || "",
      address: {
        "@type": "PostalAddress",
        streetAddress: details.address || details.neighbourhood || '',
        addressLocality: details.city,
        addressRegion: details.region,
        addressCountry: "IR",
        postalCode: details.postal_code || '',
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: details.latitude || 35.6892,
        longitude: details.longitude || 51.3890,
      },
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          opens: "08:00",
          closes: "20:00",
        }
      ],
      priceRange: details.price_range || "$$",
      aggregateRating: details.rating ? {
        "@type": "AggregateRating",
        ratingValue: details.rating,
        ratingCount: details.rating_count || 1,
        bestRating: 5,
        worstRating: 1,
      } : undefined,
      sameAs: details.website ? [details.website] : [],
      knowsAbout: [details.category_name, 'املاک', 'مشاوره املاک'],
      areaServed: {
        "@type": "City",
        name: details.city
      }
    };

    // Breadcrumb structured data
    const breadcrumbSchema = {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "خانه",
          "item": "https://ajur.app"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": details.city,
          "item": `https://ajur.app/${details.city_slug || details.city}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": details.category_name,
          "item": `https://ajur.app/${details.city_slug || details.city}/${details.category_eng_name || ''}`
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": details.name,
          "item": canonicalUrl
        }
      ]
    };

    return (
      <Head>
        {/* Performance & Connection Hints */}
        <link rel="preconnect" href="https://api.ajur.app" crossOrigin="anonymous" />
        <link rel="dns-prefetch" href="https://api.ajur.app" />
        <link rel="preconnect" href="https://maps.google.com" />
        
        {/* Preload critical resources */}
        {details.thumb && (
          <link 
            rel="preload" 
            href={details.thumb} 
            as="image" 
            type="image/jpeg"
            fetchPriority="high"
          />
        )}
        
        {/* Core Meta Tags */}
        <meta charSet="UTF-8" />
        <meta httpEquiv="X-UA-Compatible" content="IE=edge" />
        <meta httpEquiv="Content-Language" content="fa" />
        <meta name="content-language" content="fa" />
        <meta name="language" content="fa-IR" />
        <meta 
          name="viewport" 
          content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes"
        />
        <meta name="format-detection" content="telephone=no" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        
        {/* Primary Meta Tags */}
        <title>{pageTitle}</title>
        <meta name="description" content={metaDescription} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content={cleanRealstate?.name || siteName} />
        <meta name="copyright" content={`© ${new Date().getFullYear()} ${siteName}`} />
        
        {/* Robots & Indexing */}
        <meta name="robots" content="index, follow" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="revisit-after" content="7 days" />
        <meta name="rating" content="General" />
        
        {/* Open Graph (Social Media) */}
        <meta property="og:locale" content="fa_IR" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:alt" content={`${details.name} - ${details.category_name}`} />
        
        {/* Article Meta Tags */}
        {details.created_at && (
          <meta property="article:published_time" content={new Date(details.created_at).toISOString()} />
        )}
        {details.updated_at && (
          <meta property="article:modified_time" content={new Date(details.updated_at).toISOString()} />
        )}
        <meta property="article:author" content={cleanRealstate?.name || siteName} />
        <meta property="article:section" content={details.category_name} />
        {details.city && <meta property="article:tag" content={details.city} />}
        {details.region && <meta property="article:tag" content={details.region} />}
        {details.neighbourhood && <meta property="article:tag" content={details.neighbourhood} />}
        
        {/* Twitter Card */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@ajur_app" />
        <meta name="twitter:creator" content="@ajur_app" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={shareImage} />
        <meta name="twitter:image:alt" content={`${details.name} - ${details.category_name}`} />
        
        {/* Canonical URL */}
        <link rel="canonical" href={canonicalUrl} />
        
        {/* Alternate URLs for pagination/mobile if needed */}
        <link rel="alternate" href={`https://ajur.app/worker/${details.id}`} hrefLang="fa" />
        
        {/* Favicon */}
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="manifest" href="/site.webmanifest" />
        
        {/* PWA Theme */}
        <meta name="theme-color" content="#b92a31" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        
        {/* Structured Data - JSON-LD */}
        <script
          type="application/ld+json"
          dangerouslySetInnerHTML={{ __html: JSON.stringify(structuredData) }}
          key="structured-data-main"
        />
        
        <script
          type="application/ld+json"
          dangerouslySetInnerHTML={{ __html: JSON.stringify(breadcrumbSchema) }}
          key="structured-data-breadcrumb"
        />
        
        {/* Critical CSS to prevent layout shift */}
        <style dangerouslySetInnerHTML={{ __html: `
          * {
            box-sizing: border-box;
          }
          .worker-single-page .swiper {
            padding: 0 !important;
            contain: layout style paint;
          }
          .media-wrapper, .worker-single-details {
            contain: layout style paint;
          }
          .map-container {
            min-height: 300px;
            background-color: #f5f5f5;
            border-radius: 8px;
            overflow: hidden;
          }
          .sticky-call-button {
            transform: translateZ(0);
            will-change: transform;
          }
          @media (max-width: 900px) {
            .sticky-call-button {
              position: fixed;
              bottom: 0;
              left: 0;
              right: 0;
              z-index: 10001;
              padding: 16px 20px;
              background: rgba(255, 255, 255, 0.95);
              backdrop-filter: blur(10px);
            }
          }
          @media (max-width: 600px) {
            .worker-single-page {
              margin: 0 10px !important;
            }
          }
        `}} />
        
        {/* Additional meta tags for Iranian search engines */}
        <meta name="ir-site-verification-token" content="ajur-verification" />
        <meta name="ir-ranking" content="yes" />
      </Head>
    );
  }, [details, cleanRealstate]);

  // OPTIMIZATION: Memoize related workers render
  const renderRelatedWorkers = useCallback(() => {
    if (!Array.isArray(relateds) || relateds.length === 0) {
      return (
        <div style={{ 
          textAlign: 'center', 
          padding: '40px 20px',
          backgroundColor: '#f9f9f9',
          borderRadius: '8px',
          margin: '20px 0'
        }}>
          <p style={{ color: '#666', fontSize: '16px' }}>
            مورد مشابه دیگری در این منطقه یافت نشد
          </p>
        </div>
      );
    }

    return (
      <LazyLoader
        items={relateds}
        itemsPerPage={8}
        delay={300}
        renderItem={(worker) => (
          <Grid item md={4} xs={12} key={worker.id}>
            <Link 
              href={`/worker/${worker.id}?slug=${worker.slug}`}
              style={{ 
                textDecoration: 'none', 
                color: 'inherit', 
                display: 'block',
                height: '100%'
              }}
              prefetch={false}
              scroll={false}
            >
              <MemoizedWorkerCard worker={worker} />
            </Link>
          </Grid>
        )}
        loadingComponent={
          <div style={{ 
            textAlign: "center", 
            padding: "30px",
            gridColumn: "1 / -1"
          }}>
            <div style={{
              display: 'inline-block',
              width: 50,
              height: 50,
              borderRadius: '50%',
              background: 'linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%)',
              backgroundSize: '200% 100%',
              animation: 'shine 1.5s infinite linear'
            }} />
          </div>
        }
        endComponent={
          <div style={{ 
            textAlign: "center", 
            padding: "20px",
            color: "#666",
            gridColumn: "1 / -1",
            fontSize: "14px"
          }}>
            همه موارد مشابه بارگذاری شدند
          </div>
        }
        grid={true}
        gridProps={{ spacing: 2 }}
        itemProps={{ xl: 3, md: 4, xs: 12 }}
      />
    );
  }, [relateds]);

  // Skeleton loader for initial hydration
  if (!hasHydrated) {
    return (
      <div style={{ 
        minHeight: "100vh", 
        display: "flex", 
        alignItems: "center", 
        justifyContent: "center",
        backgroundColor: '#f5f5f5'
      }}>
        <div style={{
          width: 100,
          height: 100,
          borderRadius: '50%',
          background: 'linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%)',
          backgroundSize: '200% 100%',
          animation: 'shine 1.5s infinite linear'
        }} />
        <style>{`
          @keyframes shine {
            0% { background-position: -200px 0; }
            100% { background-position: calc(200px + 100%) 0; }
          }
        `}</style>
      </div>
    );
  }

  return (
    <>
      {seoHeader}

      <div 
        className={`${Styles["scroll-div"]} ${Styles["worker-single"]} worker-single-page`} 
        style={{ margin: "0 20px", minHeight: "100vh" }}
      >
        {/* Breadcrumb Navigation */}
        <Breadcrumb
          persianCategory={details.category_name}
          englishCategory={details.category_eng_name}
          englishCity={details.city_slug}
          currentPage={details.name}
        />

        {/* Main Heading for SEO - visible but with proper styling */}
        <div 
          style={{ 
            marginTop: "20px", 
            marginBottom: "30px",
            textAlign: "center"
          }} 
          itemScope 
          itemType="https://schema.org/ProfessionalService"
        >
          <h1 
            style={{ 
              fontSize: "24px", 
              color: "#333",
              margin: 0,
              lineHeight: 1.4
            }}
            itemProp="name"
          >
            {details.name} - {details.category_name} در {details.region}, {details.city}
          </h1>
          <meta itemProp="url" content={`https://ajur.app/worker/${details.id}`} />
        </div>

        <Box sx={{ flexGrow: 1 }}>
          <Grid container spacing={{ xs: 2, md: 3 }}>
            {/* Left Column - Media & Map */}
            <Grid item xs={12} md={5}>
              <div className={Styles["media-wrapper"]}>
                <WorkerMedia
                  images={images}
                  videos={videos}
                  virtual_tours={virtual_tours}
                />
                <div 
                  className={Styles["favorite-icon"]} 
                  onClick={toggleFavorite}
                  role="button"
                  tabIndex={0}
                  onKeyDown={(e) => e.key === 'Enter' && toggleFavorite()}
                  aria-label={isFavorite ? "حذف از علاقه‌مندی‌ها" : "افزودن به علاقه‌مندی‌ها"}
                  style={{ 
                    cursor: 'pointer',
                    transition: 'transform 0.2s'
                  }}
                >
                  {isFavorite ? (
                    <FavoriteIcon style={{ color: "#b92a31", fontSize: 28 }} />
                  ) : (
                    <FavoriteBorderIcon style={{ fontSize: 28 }} />
                  )}
                </div>
              </div>

              {/* Map - Desktop Only */}
              <Box sx={{ display: { xs: "none", md: "block" }, mt: 3 }}>
                <div className={Styles["title"]}>
                  <h2 style={{ fontSize: "18px", marginBottom: "12px" }}>موقعیت روی نقشه</h2>
                </div>
                <div 
                  onClick={() => setMapModalOpen(true)} 
                  style={{ 
                    cursor: "pointer",
                    position: "relative",
                    borderRadius: "8px",
                    overflow: "hidden",
                    border: "1px solid #e0e0e0"
                  }}
                  className="map-container"
                  aria-label="نمایش موقعیت روی نقشه (کلیک برای باز کردن در حالت تمام صفحه)"
                >
                  <LocationNoSsr details={details} />
                </div>
              </Box>

              {/* Realstate Card - Desktop Only */}
              {cleanRealstate.id && (
                <Box sx={{ display: { xs: "none", md: "block" }, mt: 3 }}>
                  <Link 
                    href={`/realestates/${cleanRealstate.id}?slug=${cleanRealstate.slug}`}
                    passHref
                    legacyBehavior
                    prefetch={false}
                  >
                    <WorkerRealstateCard realstate={cleanRealstate} />
                  </Link>
                </Box>
              )}
            </Grid>

            {/* Right Column - Details & Mobile Map */}
            <Grid item xs={12} md={7}>
              <div className={Styles["worker-single-details"]}>
                <WorkerDetails
                  isFavorite={isFavorite}
                  onFavoriteToggle={toggleFavorite}
                  details={details}
                  properties={properties}
                  realstate={cleanRealstate}
                />
              </div>

              {/* Map - Mobile Only */}
              <Box sx={{ display: { xs: "block", md: "none" }, mt: 3 }}>
                <div className={Styles["title"]}>
                  <h2 style={{ fontSize: "18px", marginBottom: "12px" }}>موقعیت روی نقشه</h2>
                </div>
                <div 
                  onClick={() => setMapModalOpen(true)} 
                  style={{ 
                    cursor: "pointer",
                    position: "relative",
                    borderRadius: "8px",
                    overflow: "hidden",
                    border: "1px solid #e0e0e0"
                  }}
                  className="map-container"
                  aria-label="نمایش موقعیت روی نقشه (کلیک برای باز کردن در حالت تمام صفحه)"
                >
                  <LocationNoSsr details={details} />
                </div>
              </Box>

              {/* Realstate Card - Mobile Only */}
              {cleanRealstate.id && (
                <Box sx={{ display: { xs: "block", md: "none" }, mt: 3 }}>
                  <Link 
                    href={`/realestates/${cleanRealstate.id}?slug=${cleanRealstate.slug}`}
                    passHref
                    legacyBehavior
                    prefetch={false}
                  >
                    <WorkerRealstateCard realstate={cleanRealstate} />
                  </Link>
                </Box>
              )}
            </Grid>
          </Grid>
        </Box>

        {/* Sticky Call Button - Mobile Only */}
        {(cleanRealstate?.phone || details.cellphone) && (
          <Box
            sx={{
              display: { xs: "block", md: "none" },
              position: "fixed",
              bottom: 0,
              left: 0,
              right: 0,
              padding: "16px 20px",
              backgroundColor: "rgba(255, 255, 255, 0.95)",
              backdropFilter: "blur(10px)",
              boxShadow: "0 -2px 20px rgba(0,0,0,0.1)",
              zIndex: 10001,
              transform: 'translateZ(0)'
            }}
            className="sticky-call-button"
          >
            <a
              href={`tel:${cleanRealstate?.phone || details.cellphone}`}
              style={{
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                gap: "8px",
                padding: "14px 16px",
                background: "linear-gradient(135deg, #b92a31 0%, #d84343 100%)",
                color: "#fff",
                border: "none",
                borderRadius: "12px",
                textDecoration: "none",
                fontWeight: "700",
                fontSize: "18px",
                cursor: "pointer",
                transition: "all 0.2s",
                width: "100%",
                boxShadow: "0 4px 12px rgba(185, 42, 49, 0.3)"
              }}
              aria-label={`تماس با ${cleanRealstate?.name || details.name}`}
            >
              📞 تماس : {cleanRealstate?.phone || details.cellphone}
            </a>
          </Box>
        )}

        {/* Map Modal */}
        <Dialog
          open={mapModalOpen}
          onClose={() => setMapModalOpen(false)}
          maxWidth="lg"
          fullWidth
          sx={{ 
            "& .MuiDialog-paper": { 
              height: "90vh",
              maxHeight: "90vh",
              margin: { xs: "10px", sm: "20px" }
            }
          }}
          aria-labelledby="map-dialog-title"
        >
          <div style={{ 
            display: "flex", 
            justifyContent: "space-between", 
            alignItems: "center",
            padding: "12px 16px", 
            backgroundColor: "#f5f5f5", 
            borderBottom: "1px solid #ddd" 
          }}>
            <IconButton
              onClick={() => {
                if (typeof window !== 'undefined' && details.latitude && details.longitude) {
                  const mapsUrl = `https://maps.google.com/?q=${details.latitude},${details.longitude}`;
                  window.open(mapsUrl, "_blank", "noopener,noreferrer");
                }
              }}
              title="مسیریابی در Google Maps"
              aria-label="مسیریابی در Google Maps"
              sx={{ color: "#b92a31" }}
            >
              <DirectionsIcon />
            </IconButton>
            <IconButton 
              onClick={() => setMapModalOpen(false)}
              aria-label="بستن نقشه"
              sx={{ color: "#666" }}
            >
              <CloseIcon />
            </IconButton>
          </div>
          <DialogContent sx={{ padding: 0, height: "calc(100% - 64px)" }}>
            <LocationNoSsr details={details} mapHeight="100%" />
          </DialogContent>
        </Dialog>

        {/* Related Workers Section */}
        <div style={{ marginTop: "40px", marginBottom: "20px" }}>
          <div className={Styles["title"]}>
            <h2 style={{ fontSize: "22px", marginBottom: "20px" }}>
              موارد دیگر {details.category_name} در {details.neighbourhood}, {details.city}
            </h2>
          </div>
          <Grid container spacing={{ xs: 2, md: 3 }} sx={{ marginTop: "10px" }}>
            {renderRelatedWorkers()}
          </Grid>
        </div>
      </div>
    </>
  );
};

WorkerSingle.propTypes = {
  details: PropTypes.shape({
    id: PropTypes.string.isRequired,
    name: PropTypes.string,
    category_name: PropTypes.string,
    region: PropTypes.string,
    city: PropTypes.string,
    neighbourhood: PropTypes.string,
    address: PropTypes.string,
    description: PropTypes.string,
    thumb: PropTypes.string,
    phone: PropTypes.string,
    cellphone: PropTypes.string,
    latitude: PropTypes.number,
    longitude: PropTypes.number,
    created_at: PropTypes.string,
    updated_at: PropTypes.string,
    rating: PropTypes.number,
    rating_count: PropTypes.number,
    city_slug: PropTypes.string,
    category_eng_name: PropTypes.string,
    seo_title: PropTypes.string,
    seo_description: PropTypes.string,
    seo_keywords: PropTypes.string,
  }).isRequired,
  images: PropTypes.array.isRequired,
  videos: PropTypes.array.isRequired,
  virtual_tours: PropTypes.array.isRequired,
  properties: PropTypes.array.isRequired,
  realstate: PropTypes.object.isRequired,
  relateds: PropTypes.array.isRequired,
};

// Server-side props with better caching and error handling
export async function getServerSideProps(context) {
  const { params, res, req } = context;
  const id = params.id;

  // Set cache headers for CDN and browser
  res.setHeader('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');
  
  // Set security headers
  res.setHeader('X-Content-Type-Options', 'nosniff');
  res.setHeader('X-Frame-Options', 'DENY');
  res.setHeader('X-XSS-Protection', '1; mode=block');
  
  // Add performance headers
  res.setHeader('Server-Timing', 'fetch;desc="API Fetch"');

  try {
    // Create abort controller for timeout
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 8000); // 8 second timeout

    const startTime = Date.now();
    
    const response = await fetch(`https://api.ajur.app/api/posts/${id}`, {
      signal: controller.signal,
      headers: {
        'Accept-Encoding': 'gzip, deflate, br',
        'Accept': 'application/json',
        'User-Agent': 'Ajur-App-SSR/1.0',
      },
      // Add keepalive for better connection reuse
      keepalive: true,
    });

    clearTimeout(timeoutId);

    if (!response.ok) {
      // Log the error but don't throw for non-critical issues
      console.warn(`API returned ${response.status} for worker ${id}`);
      
      // Return minimal props for error recovery
      return {
        props: {
          details: { 
            id,
            name: '',
            category_name: '',
            city: '',
            region: '',
            thumb: 'https://api.ajur.app/logo/og-default.jpg'
          },
          images: [],
          videos: [],
          virtual_tours: [],
          properties: [],
          realstate: {},
          relateds: [],
        },
      };
    }

    const data = await response.json();
    const fetchTime = Date.now() - startTime;
    
    // Add server timing header
    res.setHeader('Server-Timing', `fetch;dur=${fetchTime};desc="API Fetch"`);

    // Clean and structure the data
    const cleanDetails = {
      ...data.details,
      name: cleanText(data.details.name || ''),
      category_name: cleanText(data.details.category_name || ''),
      region: cleanText(data.details.region || ''),
      city: cleanText(data.details.city || ''),
      neighbourhood: cleanText(data.details.neighbourhood || ''),
      address: cleanText(data.details.address || ''),
      description: cleanText(data.details.description || ''),
      // Ensure critical fields exist
      thumb: data.details.thumb || 'https://api.ajur.app/logo/og-default.jpg',
      city_slug: data.details.city_slug || data.details.city,
      category_eng_name: data.details.category_eng_name || '',
    };

    const cleanRealstate = data.realstate ? {
      ...data.realstate,
      name: cleanText(data.realstate.name || ''),
      slug: data.realstate.slug || '',
    } : {};

    return {
      props: {
        details: cleanDetails,
        images: data.images || [],
        videos: data.videos || [],
        virtual_tours: data.virtual_tours || [],
        properties: data.properties || [],
        realstate: cleanRealstate,
        relateds: data.relateds || [],
      },
    };
  } catch (error) {
    console.error("Error fetching worker data:", error);
    
    // Return safe fallback props
    return {
      props: {
        details: { 
          id,
          name: '',
          category_name: '',
          city: '',
          region: '',
          thumb: 'https://api.ajur.app/logo/og-default.jpg'
        },
        images: [],
        videos: [],
        virtual_tours: [],
        properties: [],
        realstate: {},
        relateds: [],
      },
    };
  }
}

export default React.memo(WorkerSingle);





















