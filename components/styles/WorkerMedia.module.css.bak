  justify-content: flex-start;
  padding: 20px;
  overflow: auto;
}

.lightboxOverlay.fullscreen {
  background: #000;
  padding: 0;
  overflow: hidden;
}

.lightboxCloseBtn {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 4002;
  background: #fff;
  border: none;
  border-radius: 50%;
  width: 44px;
  height: 44px;
  cursor: pointer;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  transition: all 0.2s ease;
}

.lightboxCloseBtn:hover {
  transform: scale(1.1);
  background: #f0f0f0;
}

.lightboxImageContainer {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  cursor: grab;
  touch-action: none;
}

.lightboxImageContainer.dragging {
  cursor: grabbing;
}

.lightboxImage {
  max-width: 95vw;
  max-height: 95vh;
  object-fit: contain;
  transition: none;
  will-change: transform, object-position;
  pointer-events: none;
  display: block;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

.lightboxImage.dragging {
  transition: none;
  transform: scale(1.02);
}

.lightboxNavLeft,
.lightboxNavRight {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  z-index: 4002;
  background: rgba(255, 255, 255, 0.9);
  border: none;
  border-radius: 4px;
  width: 50px;
  height: 50px;
  cursor: pointer;
  font-size: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.lightboxNavLeft {
  left: 20px;
}

.lightboxNavRight {
  right: 20px;
}

.lightboxNavLeft:hover,
.lightboxNavRight:hover {
  background: rgba(255, 255, 255, 1);
  transform: translateY(-50%) scale(1.1);
}

.lightboxCounter {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 4002;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 10px 20px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 600;
}

/* Gallery grid for lightbox */
.gridGallery {
  margin-top: 40px;
  margin-bottom: 40px;
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: flex-start;
  justify-content: flex-start;
}

.gridItem {
  display: inline-block;
  overflow: hidden;
  border-radius: 8px;
  cursor: pointer;
  background: #fff;
  transition: all 0.25s ease;
  box-shadow: 0 6px 18px rgba(0,0,0,0.06);
  width: calc(50% - 12px);
  height: 320px;
}

.gridItem:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0,102,204,0.12);
}

.gridImage {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  -webkit-perspective: 1000;
  perspective: 1000;
}

/* No media fallback */
.noMedia {
  width: 100%;
  height: 400px;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .gridItem {
    width: calc(50% - 12px);
    height: 300px;
  }
}

@media (max-width: 768px) {
  .swiperContainer {
    height: 280px;
  }
  
  .mainImage {
    height: 280px;
  }
  
  .iframe,
  .video {
    height: 280px;
  }
}

@media (max-width: 600px) {
  .gridItem {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
  }
  
  .gridImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .lightboxNavLeft,
  .lightboxNavRight {
    width: 40px;
    height: 40px;
    font-size: 24px;
  }
  
  .lightboxCloseBtn {
    width: 40px;
    height: 40px;
    font-size: 24px;
  }
}

@media (max-width: 480px) {
  .swiperContainer {
    height: 330px;
  }
  
  .mainImage {
    height: 330px;
  }
  
  .iframe,
  .video {
    height: 330px;
  }
}

@media (min-width: 1400px) {
  .gridItem {
    width: calc(33.333% - 12px);
  }
}

/* Performance optimization for animations */
@media (prefers-reduced-motion: reduce) {
  .mainImage.animating,
  .lightboxImage {
    animation: none;
    transition: none;
  }
}

/* Smooth scrolling for containers */
.mediaContainer,
.swiperContainer {
  -webkit-overflow-scrolling: touch;
}

/* Loading state for images */
.mainImage.loading {
  opacity: 0;
}

.mainImage.loaded {
  opacity: 1;
  transition: opacity 0.3s ease;
}
























////////// the animation is almost fine //////////////////////


.wrapper {
  margin-top: 0px;
  position: relative;
  width: 100%;
}

.mediaContainer {
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
}

.mainImageWrapper {
  position: relative;
  width: 100%;
}

.swiperContainer {
  width: 100%;
  height: 400px;
  position: relative;
  overflow: hidden;
}

/* Image container with grab cursor */
.imageContainer {
  width: 100%;
  height: 100%;
  overflow: hidden;
  position: relative;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  touch-action: pan-y pinch-zoom;
  -webkit-tap-highlight-color: transparent;
}

.imageContainer.dragging {
  cursor: grabbing;
  touch-action: none;
}

/* Main image with object-position animation */
.mainImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 12px;
  transition: none;
  will-change: transform, object-position;
  pointer-events: none;
  display: block;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
}

/* When dragging, maintain no transition */
.mainImage.dragging {
  transition: none;
}

/* Animation class for JS-driven animations */
.mainImage.animating {
  transition: none;
}

/* Ensure smooth performance during animation */
.mainImage.animating {
  pointer-events: none;
}

/* Restore pointer events when dragging */
.mainImage.dragging {
  pointer-events: none;
}

.iframe {
  width: 100%;
  height: 500px;
  border: none;
  border-radius: 12px;
}

.video {
  width: 100%;
  height: auto;
  max-height: 400px;
  object-fit: contain;
  background-color: #000;
  border-radius: 12px;
  display: block;
  margin: 0 auto;
}

/* Media Box Row */
.mediaBoxRow {
  display: flex;
  gap: 12px;
  margin-top: 16px;
  justify-content: space-between;
  flex-wrap: nowrap;
}

.mediaBox {
  flex: 1;
  min-width: 0;
  background-color: #f9f9f9;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  text-align: center;
  padding: 2px;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.mediaBox:hover {
  transform: scale(1.03);
}

.thumbnailContainer {
  position: relative;
  width: 100%;
  height: 100px;
  margin-bottom: 1px;
}

.thumbnail {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 6px;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  -webkit-perspective: 1000;
  perspective: 1000;
}

.mediaCounter {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -10%);
  background-color: rgba(0, 0, 0, 0.3);
  color: white;
  padding: 4px 2px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 24px;
  direction: rtl;
}

.mediaCounterVideo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.3);
  color: white;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 24px;
}

/* Pagination Indicators */
.paginationIndicators {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  z-index: 20;
}

.indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.5);
  cursor: pointer;
  transition: all 0.3s ease;
  border: 2px solid transparent;
  padding: 0;
}

.indicator:hover {
  background-color: rgba(255, 255, 255, 0.8);
}

.indicator.active {
  width: 20px;
  border-radius: 4px;
  background-color: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

/* Navigation Arrows */
.navArrow {
  background: rgba(255, 255, 255, 0.8);
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  cursor: pointer;
  font-size: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
  z-index: 10;
}

.navArrow:hover {
  background: rgba(255, 255, 255, 0.95);
  transform: translateY(-50%) scale(1.1);
}

/* Lightbox Styles */
