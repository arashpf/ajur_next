  };

  // Handle final submission
  const handleFinalSubmit = () => {
    // Validate all fields
    const cityError = !addressCity || addressCity.trim() === '';
    const neighborhoodError = !addressNeighbourhood || addressNeighbourhood.trim() === '';
    const addressError = !addressFormatted || addressFormatted.trim() === '';

    // Update validation errors
    setValidationErrors({
      city: cityError,
      neighborhood: neighborhoodError,
      address: addressError
    });

    // Mark all fields as touched
    setTouched({
      city: true,
      neighborhood: true,
      address: true
    });

    if (!isSelected) {
      setProblem("لطفا ابتدا موقعیت ملک را مشخص کنید");
      set_alert_sevirity("warning");
      setOpenSnackBar(true);
      return;
    }
    
    if (cityError) {
      setProblem("لطفا شهر را انتخاب کنید");
      set_alert_sevirity("warning");
      setOpenSnackBar(true);
      return;
    } else if (neighborhoodError) {
      setProblem("لطفا محله را انتخاب کنید");
      set_alert_sevirity("warning");
      setOpenSnackBar(true);
      return;
    } else if (addressError) {
      setProblem("لطفا آدرس را پر کنید");
      set_alert_sevirity("warning");
      setOpenSnackBar(true);
      return;
    }

    set_btn_status(true);
    var token = Cookies.get("id_token");

    axios({
      method: "post",
      url: "https://api.ajur.app/api/post-model-location",
      timeout: 1000 * 35,
      params: {
        token: token,
        lat: final_lat,
        long: final_lng,
        worker_id: returnedWorker.id,
        region: addressRegion,
        neighbourhood: addressNeighbourhood,
        city: addressCity,
        municipality_zone: addressMunicipality_zone,
        state: addressState,
        formatted: addressFormatted,
      },
    })
      .then((response) => {
        if (response.data.status == "200") {
          set_alert_sevirity("success");
          setProblem("آگهی شما با موفقیت ثبت شد");
          setOpenSnackBar(true);
          router.push("/panel");
          set_btn_status(false);
        } else {
          set_alert_sevirity("warning");
          setProblem("متاسفانه با مشکلی مواجه شدیم");
          set_btn_status(false);
          setOpenSnackBar(true);
        }
      })
      .catch((e) => {
        set_alert_sevirity("warning");
        setProblem("error 500");
        setOpenSnackBar(true);
        set_btn_status(false);
      });
  };

  // Function to check geolocation permission
  const checkGeolocationPermission = async () => {
    if (navigator.permissions && navigator.permissions.query) {
      try {
        const result = await navigator.permissions.query({ name: 'geolocation' });
        
        if (result.state === 'denied') {
          setShowPermissionDialog(true);
          return false;
        }
      } catch (error) {
        console.error("Error checking permission:", error);
      }
    }
    return true;
  };

  // Function to get current location with proper error handling
  const getCurrentLocation = () => {
    // First check if geolocation is supported
    if (!navigator.geolocation) {
      setProblem("مرورگر شما از موقعیت مکانی پشتیبانی نمی‌کند");
      set_alert_sevirity("warning");
      setOpenSnackBar(true);
      return;
    }

    // Check permission first
    checkGeolocationPermission().then((hasPermission) => {
      if (!hasPermission) return;

      // Set loading state
      setIsGeocoding(true);
      setGeocodingApi("neshan");
      setProblem("در حال دریافت موقعیت مکانی...");
      set_alert_sevirity("info");
      setOpenSnackBar(true);

      // Options for geolocation
      const options = {
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 0
      };

      // Success callback
      const successCallback = (position) => {
        const { latitude, longitude } = position.coords;
        
        setSelectedPosition([latitude, longitude]);
        set_final_lat(latitude);
        set_final_lng(longitude);
        set_isSelected(true);
        
        // Close the loading message
        setOpenSnackBar(false);
        
        // Reverse geocode the location
        reverseGeocode(latitude, longitude);
        
        // Fly to the location on map
        if (mapRef.current) {
          mapRef.current.flyTo([latitude, longitude], 17, {
            duration: 2
          });
        }
      };

      // Error callback with detailed messages
      const errorCallback = (error) => {
        setIsGeocoding(false);
        
        let errorMessage = "";
        switch(error.code) {
          case error.PERMISSION_DENIED:
            errorMessage = "دسترسی به موقعیت مکانی رد شد. لطفا از تنظیمات مرورگر دسترسی را فعال کنید";
            setShowPermissionDialog(true);
            break;
          case error.POSITION_UNAVAILABLE:
            errorMessage = "اطلاعات موقعیت مکانی در دسترس نیست";
            break;
          case error.TIMEOUT:
            errorMessage = "زمان دریافت موقعیت مکانی به پایان رسید";
            break;
          default:
            errorMessage = "خطا در دریافت موقعیت مکانی";
            break;
        }
        
        setProblem(errorMessage);
        set_alert_sevirity("error");
        setOpenSnackBar(true);
        
        console.error("Geolocation error:", error);
      };

      // Request location
      navigator.geolocation.getCurrentPosition(
        successCallback, 
        errorCallback, 
        options
      );
    });
  };

